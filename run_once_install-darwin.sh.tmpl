#!/bin/bash
{{ if ne .chezmoi.os "darwin" }}exit 0{{ end }}

set -e

# Formulae
brew install \
  bat \
  chezmoi \
  fastfetch \
  fd \
  fish \
  fnm \
  fzf \
  gh \
  herdr \
  lazygit \
  ripgrep \
  zellij

# Casks
brew install --cask \
  alt-tab \
  font-maple-mono \
  font-noto-sans-jp \
  ghostty \
  karabiner-elements \
  raycast \
  scroll-reverser \
  spotify \
  zed

# Node.js
eval "$(fnm env)"
fnm install --lts
fnm use lts-latest

# Claude Code（ネイティブインストーラー）
curl -fsSL https://claude.ai/install.sh | bash

# Default shell を fish に変更
if ! grep -q "$(brew --prefix)/bin/fish" /etc/shells; then
  echo "$(brew --prefix)/bin/fish" | sudo tee -a /etc/shells
fi
if [ "$SHELL" != "$(brew --prefix)/bin/fish" ]; then
  chsh -s "$(brew --prefix)/bin/fish"
fi
