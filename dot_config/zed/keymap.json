
// Zed のドキュメント: https://zed.dev/docs/key-bindings
//
// デフォルトのキーバインド一覧は、コマンドパレットから
// `zed: open default keymap` を実行すると確認可能
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "ProjectSearchBar",
    "unbind": {
      "cmd-shift-j": "project_search::ToggleFilters"
    }
  },
  {
    "context": "ProjectSearchView",
    "unbind": {
      "cmd-shift-j": "project_search::ToggleFilters"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-j": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "alt-cmd-b": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      // Hyper+oで最近使ったプロジェクトに切り替え
      "ctrl-alt-cmd-o": "projects::OpenRecent",
      // 右ドックのgitとagentパネル呼び出し
      "ctrl-alt-cmd-g": "git_panel::ToggleFocus",
      "ctrl-alt-cmd-h": "agent::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-r": "projects::OpenRecent"
    }
  },
  {
    // デフォルトではインデント操作(Outdent/Indent)で埋まっているので
    // 段落ジャンプで使う前に無効化
    "context": "Editor",
    "unbind": {
      "cmd-[": "editor::Outdent",
      "cmd-]": "editor::Indent"
    }
  },
  {
    // 現在のブロックを選択する，AST単位の移動を兼用中
    "context": "Editor",
    "bindings": {
      "cmd-[": "editor::SelectPreviousSyntaxNode",
      "cmd-]": "editor::SelectNextSyntaxNode"
    }
  },
  {
    // 空行区切りのコードブロック単位でジャンプ
    "context": "Editor",
    "bindings": {
      "cmd-ctrl-[": "editor::MoveToStartOfParagraph",
      "cmd-ctrl-]": "editor::MoveToEndOfParagraph"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      // ZENモード
      // centered_layout の設定に基づき、エディタを中央寄せするモードをON/OFF
      "ctrl-alt-cmd-x": "workspace::ToggleCenteredLayout",
      // centered_layout のON/OFFをまとめて切り替える。
      // ドックは直前の開閉状態を覚えているので、もう一度押せば
      // ドックが元通り開き、centered_layoutもOFFに戻る(比較モード)。
      "ctrl-alt-cmd-z": ["workspace::SendKeystrokes", "alt-cmd-y ctrl-alt-cmd-c"]
    }
  },
  {
    "unbind": {
      "cmd-shift-c": "collab_panel::ToggleFocus"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-alt-cmd-c": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "ProjectPanel",
    "unbind": {
      "alt-cmd-shift-c": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "ctrl-alt-cmd-c": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "OutlinePanel && not_editing",
    "unbind": {
      "alt-cmd-shift-c": "workspace::CopyRelativePath"
    }
  }
]
