# --- フォント ---
font-size = 16
adjust-cell-height = 10%
# フォントファミリー
# 英字Maple Mono
font-family = Maple Mono
# 日本語用．
font-family = Noto Sans JP
font-style = Bold
# ---------------

# テーマ
theme = Material Design Colors

# 装飾
# 赤系のアクセントカラー
palette = 1=#ff5555
palette = 9=#ff6e67

# ピンク/赤系の強調色
palette = 5=#ff79c6
palette = 13=#ff92d0

# ウィンドウの装飾
window-decoration = true

# アニメーション
quick-terminal-animation-duration = 0.3

# --- ウィンドウ・透明度 ---
# ウィンドウ透過とブラー
# background-opacity = 0.85
background-blur-radius = 20

# 背景画像(ローカルフォルダなので環境が変わったら手動で変更すること)
background-image = /Users/yuzu/Pictures/wallpaper/miku5.jpg
background-image-opacity = 0.1
background-image-fit = cover

# ウィンドウ内の余白
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true

# 入力中はマウスカーソルを隠す
mouse-hide-while-typing = true

# --- Macネイティブな挙動 ---
macos-titlebar-style = transparent
macos-window-shadow = true

# --- 操作性 ---
# 選択しただけでクリップボードにコピー
copy-on-select = true
# クリップボードの読み書きを許可
clipboard-read = allow
clipboard-write = allow

# --- キーバインド設定（画面分割） ---
# マルチプレクサ側でペイン分割するのでコメントアウト
# cmd+Enter で「下に」分割
# keybind = cmd+enter=new_split:down
# cmd+Shift+Enter で「右に」分割
# keybind = cmd+shift+enter=new_split:right
# cmd + 矢印キー で分割した画面を「移動」
# keybind = cmd+left=goto_split:left
# keybind = cmd+right=goto_split:right
# keybind = cmd+up=goto_split:top
# keybind = cmd+down=goto_split:bottom
# cmd + Shift + 矢印キー でサイズを「調整」
# keybind = cmd+shift+left=resize_split:left,20
# keybind = cmd+shift+right=resize_split:right,20
# keybind = cmd+shift+up=resize_split:up,20
# keybind = cmd+shift+down=resize_split:down,20

# cmd + W で現在の「ペイン（分割）」を閉じる
keybind = cmd+w=close_surface
# cmd + Shift + W でウィンドウを閉じる
keybind = cmd+shift+w=close_window

# herdr にタブ/ワークスペース切り替えを渡すため、Ghostty 標準の
# goto_split / native tab 切り替えバインドを解除してキーを通過させる
keybind = cmd+[=unbind
keybind = cmd+]=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind

# herdr の新規タブ (cmd+n) に渡すため、Ghostty 標準の new_window を解除
# （cmd+shift+n は Ghostty 側で未割り当てのため対応不要）
keybind = cmd+n=unbind

# --- カーソル ---
# herdr 内ではシェル統合のカーソル形状指定が届かずブロックのままになるため明示する
cursor-style = bar
# テーマ既定の #eaeaea だと点滅時に白飛びするのでミクティールにする
cursor-color = #39C5BB
cursor-text = #000000

# --- カーソルシェーダー ---
# カーソル移動時
custom-shader = shaders/miku_cursor_trail.glsl
# insert/normalモード切替時
custom-shader = shaders/miku_digital_ripple.glsl
# フォーカスが外れてもアニメーションを継続
custom-shader-animation = always
